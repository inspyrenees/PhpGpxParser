{
  "name": "inspyrenees/phpgpxparser",
  "description": "GPX parsing and analysis toolkit in PHP, with elevation correction using the IGN API.",
  "type": "library",
  "version": "1.2.2",
  "minimum-stability": "stable",
  "license": "MIT",
  "keywords": ["ign", "gpx", "elevation", "parser"],
  "authors": [
    {
      "name": "MINET Simon",
      "email": "simon@inspyrenees.fr"
    }
  ],
  "require": {
    "php": ">=8.2",
    "symfony/http-client": "^7.2||^8.0",
    "mjaschen/phpgeo": "^6.0",
    "markrogoyski/math-php": "^2.13"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5",
    "symfony/var-dumper": "^8.0"
  },
  "autoload": {
    "psr-4": {
      "PhpGpxParser\\": "src/PhpGpxParser"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PhpGpxParser\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": false
    }
  }
}
